# KODA Local AI
# Example environment configuration

# Current v0.1 code still uses local defaults in several places.
# These variables define the planned configuration interface.

KODA_LLM_MODEL=gemma3:4b
KODA_LLM_BASE_URL=http://127.0.0.1:11434
KODA_LLM_MODE=offline

KODA_CHROMA_DIR=chroma_db
KODA_DOCS_DIR=data/documents

# Development audit logging
# Planned to become an explicit runtime option.
KODA_AUDIT_ENABLED=false
